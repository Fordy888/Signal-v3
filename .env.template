# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Resend for email delivery (replaces Gmail SMTP)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=signal@signal.dtlc.ai

# Proof / alert destination. src/main.py falls back to RECIPIENT_EMAIL if unset.
PROOF_RECIPIENT_EMAIL=paul.ford@gmail.com

# Legacy fallback recipient — not used when the subscriber API is active.
RECIPIENT_EMAIL=paul@dtlc.ai

# DTLC.ai website — source of truth for active subscribers.
# Required for --send and --proof runs; without these the subscriber fetch fails.
WEBSITE_BASE_URL=https://dtlc.ai
SIGNAL_PIPELINE_API_KEY=your-pipeline-api-key

# BetterStack monitoring
BETTERSTACK_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/your-token

# Optional — override default models
MODEL_SCORING=claude-haiku-4-5-20251001
MODEL_SYNTHESIS=claude-sonnet-4-6
MODEL_FOUNDERS_NOTE=claude-sonnet-4-6

# Signal Strength Gauge
# ENABLE_GAUGE: off | on | proof | selected
ENABLE_GAUGE=off
GAUGE_BASE_URL=https://dtlc.ai/api/gauge
# GAUGE_MODE: static (default) | interactive
# GAUGE_MODE=static
# Comma-separated edition numbers, used only when ENABLE_GAUGE=selected
# GAUGE_EDITIONS=

# Timezone — matches the Render services
TZ=Australia/Brisbane
